root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# Line endings are intentionally not specified yet; existing files may retain
# their current CRLF/LF convention until the repository adopts one policy.
